# Ubuntu 24.04 container for CPU-encoder compatibility and interactive gates.
#
# Keep this separate from Containerfile: the ordinary matrix deliberately
# models the Debian development host, while this arm must exercise Ubuntu
# 24.04's FFmpeg 6/libx264 bitstream.
FROM ubuntu:24.04 AS visual-build

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential pkg-config \
        libcairo2-dev libx11-dev libxext-dev libxrandr-dev \
    && rm -rf /var/lib/apt/lists/*
COPY textflood.c colorkey_x11.c chroma_strip_anim.c /src/
RUN cc -O2 -Wall -Wextra -Wno-unused-parameter -o /src/textflood \
        /src/textflood.c $(pkg-config --cflags --libs cairo x11 xext xrandr) \
    && cc -O2 -Wall -Wextra -o /src/colorkey_x11 \
        /src/colorkey_x11.c -lX11 \
    && cc -O2 -Wall -o /src/chroma_strip_anim \
        /src/chroma_strip_anim.c -lX11

FROM ubuntu:24.04

ARG XRDP_DEB
ARG XORGXRDP_DEB
ARG INSTALL_ACCEPTANCE_DESKTOP=0
ARG CHROMIUM_REVISION=1686537
ARG CHROMIUM_SHA256=cb945d510c518e2a93a8b885bbba65b83dd7837e8b9eb8a3a6f835199726cad6

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        ffmpeg \
        xserver-xorg-core xserver-xorg-legacy \
        x11-xserver-utils xterm xfonts-base fonts-dejavu-core \
        dbus procps openssl ca-certificates xdotool \
        libcairo2 libx11-6 libxext6 libxfixes3 libxrandr2 python3-tk \
    && rm -rf /var/lib/apt/lists/*

COPY --from=visual-build /src/textflood /usr/local/bin/textflood
COPY --from=visual-build /src/colorkey_x11 /usr/local/bin/colorkey_x11
COPY --from=visual-build /src/chroma_strip_anim \
     /usr/local/bin/chroma_strip_anim
COPY chroma_probe.py /usr/local/bin/chroma-probe
RUN chmod 755 /usr/local/bin/textflood /usr/local/bin/colorkey_x11 \
              /usr/local/bin/chroma_strip_anim /usr/local/bin/chroma-probe

ARG INSTALL_XFCE=0
RUN if [ "$INSTALL_XFCE" = "1" ]; then \
        apt-get update \
        && apt-get install -y --no-install-recommends \
            xfce4-session xfwm4 xfdesktop4 xfce4-panel xfce4-settings \
            xfce4-terminal lxterminal dbus-x11 \
        && rm -rf /var/lib/apt/lists/*; \
    fi

COPY chromium-container chromium-container.desktop /tmp/acceptance/
RUN if [ "$INSTALL_ACCEPTANCE_DESKTOP" = "1" ]; then \
        apt-get update \
        && apt-get install -y --no-install-recommends \
            curl unzip desktop-file-utils thunar fonts-liberation \
            libasound2t64 libatspi2.0-0t64 libcups2t64 libgbm1 \
            libgtk-3-0t64 libnss3 libxcomposite1 libxdamage1 \
            libxkbcommon0 \
        && curl -fsSL --retry 3 \
            -o /tmp/chrome-linux.zip \
            "https://storage.googleapis.com/chromium-browser-snapshots/Linux_x64/${CHROMIUM_REVISION}/chrome-linux.zip" \
        && printf '%s  %s\n' "$CHROMIUM_SHA256" /tmp/chrome-linux.zip \
            | sha256sum -c - \
        && unzip -q /tmp/chrome-linux.zip -d /opt \
        && install -m 0755 /tmp/acceptance/chromium-container \
            /usr/local/bin/chromium-container \
        && install -m 0644 /tmp/acceptance/chromium-container.desktop \
            /usr/share/applications/chromium-container.desktop \
        && install -m 0644 /opt/chrome-linux/product_logo_48.png \
            /usr/share/pixmaps/chromium-container.png \
        && desktop-file-validate \
            /usr/share/applications/chromium-container.desktop \
        && rm -f /tmp/chrome-linux.zip \
        && rm -rf /var/lib/apt/lists/*; \
    fi

COPY ${XRDP_DEB} ${XORGXRDP_DEB} /tmp/debs/
RUN apt-get update \
    && apt-get install -y --no-install-recommends /tmp/debs/*.deb \
    && rm -rf /tmp/debs /var/lib/apt/lists/*

# Ubuntu reserves uid 1000 for its image account; account identity is not
# part of this codec gate, so use stable, unoccupied local ids.
RUN printf 'allowed_users=anybody\nneeds_root_rights=no\n' \
        > /etc/X11/Xwrapper.config \
    && sed -i -e 's|^port=3389|port=tcp://:3389|' \
              -e 's|^autorun=$|autorun=Xorg|' /etc/xrdp/xrdp.ini \
    && groupadd -f render \
    && useradd -m -u 1100 -s /bin/bash tester \
    && usermod -aG video,render tester \
    && useradd -m -u 1101 -s /bin/bash probe444 \
    && usermod -aG video,render probe444 \
    && if [ "$INSTALL_ACCEPTANCE_DESKTOP" = "1" ]; then \
        usermod -aG root tester \
        && usermod -aG root probe444; \
    fi

COPY startwm.sh /etc/xrdp/startwm.sh
COPY banner.sh /usr/local/bin/banner.sh
COPY entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod 755 /etc/xrdp/startwm.sh /usr/local/bin/banner.sh \
              /usr/local/bin/entrypoint.sh

EXPOSE 3389
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
