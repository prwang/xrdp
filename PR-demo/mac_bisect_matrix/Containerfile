# Containerfile — one self-contained xrdp server per bisect arm.
#
# Owner directive (2026-07-26, CLAUDE.md "Bisect/diagnosis sessions"): during
# a bisect we never mutate the host's deployed xrdp instance. Every variant
# under test runs as its own pod built from this image, with its own binaries
# and its own /etc/xrdp/gfx.toml (ConfigMap), all arms up at once on distinct
# loopback host ports. SERVER SIDE ONLY — the client harness on the host is
# never rebuilt or redeployed as part of a bisect.
#
# Build (from PR-demo/mac_bisect_matrix; build_and_deploy.sh does this):
#   podman build --build-arg XRDP_DEB=<file> --build-arg XORGXRDP_DEB=<file> \
#       -t xrdp-bisect:<tag> -f Containerfile .build/
#
# The image replicates the dev box (Debian 13) Mac-good baseline environment:
# distro ffmpeg + Mesa radeonsi VAAPI, xserver-xorg-legacy with
# allowed_users=anybody, xrdp.ini autorun=Xorg. GPU comes in via a /dev/dri
# hostPath; the session is a deterministic full-screen arm banner (banner.sh),
# identical in every arm, so the ONLY difference between arms is the xrdp
# deb + gfx.toml.

# --- textflood builder (BACKLOG #61b) -------------------------------------
# textflood rasterizes the corpus with cairo in ITS OWN process and hands X
# one finished image over MIT-SHM: 7.7x less X-thread cost than the xterm
# codeflood payload (#62). #61c measured why that matters here -- under
# codeflood the session Xorg is at 98.9 % of a core with NO client attached,
# so the producer answers every throughput question before xrdp gets to.
#
# Built in a separate stage so the runtime image carries the binary and the
# cairo/X11 RUNTIME libs, but none of the toolchain.
FROM debian:trixie AS textflood-build
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential pkg-config \
        libcairo2-dev libx11-dev libxext-dev libxrandr-dev \
    && rm -rf /var/lib/apt/lists/*
COPY textflood.c /src/textflood.c
RUN cc -O2 -Wall -Wextra -Wno-unused-parameter -o /src/textflood \
        /src/textflood.c $(pkg-config --cflags --libs cairo x11 xext xrandr)

# The onscreen probes a human judges the session with. They were being
# copied into running pods by hand on 2026-08-08, which meant they died
# with the pod and an arm could not be handed over reproducibly; the
# missing python3-tk for chroma-probe was found the same way. Built here
# so the runtime image carries binaries and no toolchain. See
# PR-demo/README.md for which probe answers which question.
COPY colorkey_x11.c /src/colorkey_x11.c
COPY chroma_strip_anim.c /src/chroma_strip_anim.c
RUN cc -O2 -Wall -Wextra -o /src/colorkey_x11 /src/colorkey_x11.c -lX11 \
    && cc -O2 -Wall -o /src/chroma_strip_anim /src/chroma_strip_anim.c -lX11

FROM debian:trixie

ARG XRDP_DEB
ARG XORGXRDP_DEB

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        ffmpeg \
        libva2 libva-drm2 mesa-va-drivers vainfo \
        xserver-xorg-core xserver-xorg-legacy \
        x11-xserver-utils xterm xfonts-base fonts-dejavu-core \
        dbus procps openssl ca-certificates \
        xdotool \
        libcairo2 libx11-6 libxext6 libxrandr2 \
        python3-tk \
    && rm -rf /var/lib/apt/lists/*
# python3-tk is chroma-probe's ONLY dependency and it is not pulled in by
# anything else here. Its absence is why chroma-probe could not be started
# in an arm on 2026-08-08.

# BACKLOG #61b: the textflood payload binary (SESSION_KIND=textflood).
# Runtime libs only -- the toolchain stays in the builder stage.
COPY --from=textflood-build /src/textflood /usr/local/bin/textflood
RUN chmod 755 /usr/local/bin/textflood

# The onscreen probes, so an arm can be handed to a human without
# copying anything into the running pod:
#   chroma-probe        AVC444 main/aux pairing (needs python3-tk, above)
#   colorkey_x11        flow control and motion, in real pixels
#   chroma_strip_anim   4:4:4 versus 4:2:0
COPY --from=textflood-build /src/colorkey_x11 /usr/local/bin/colorkey_x11
COPY --from=textflood-build /src/chroma_strip_anim \
     /usr/local/bin/chroma_strip_anim
COPY chroma_probe.py /usr/local/bin/chroma-probe
RUN chmod 755 /usr/local/bin/colorkey_x11 \
              /usr/local/bin/chroma_strip_anim \
              /usr/local/bin/chroma-probe

# Optional full desktop (arm-g class): real content — wallpaper
# gradients, antialiased text, window chrome — is where the Mac
# wrong-color symptom was observed; the banner alone can't fully clear
# a chroma fault. WITH recommends deliberately: match a real install.
ARG INSTALL_XFCE=0
RUN if [ "$INSTALL_XFCE" = "1" ]; then \
        apt-get update \
        && apt-get install -y xfce4 xfce4-terminal lxterminal dbus-x11 \
        && rm -rf /var/lib/apt/lists/*; \
    fi

# xrdp + xorgxrdp developer debs for THIS arm (copied into the build context
# by build_and_deploy.sh; /work/dist is the deb archive of record)
COPY ${XRDP_DEB} ${XORGXRDP_DEB} /tmp/debs/
RUN apt-get update \
    && apt-get install -y --no-install-recommends /tmp/debs/*.deb \
    && rm -rf /tmp/debs /var/lib/apt/lists/*

# Match the dev box Xorg wrapper policy (sesman starts Xorg as the user)
RUN printf 'allowed_users=anybody\nneeds_root_rights=no\n' \
        > /etc/X11/Xwrapper.config

# Match the dev box xrdp.ini deltas, except the listen address: inside the
# pod netns xrdp must listen on all interfaces so the CNI hostPort DNAT
# (127.0.0.1:<arm port> on the host) can reach it.
RUN sed -i -e 's|^port=3389|port=tcp://:3389|' \
           -e 's|^autorun=$|autorun=Xorg|' /etc/xrdp/xrdp.ini

# tester account mirrors the host baseline account the owner already uses;
# the password hash is injected at runtime (entrypoint) from a host-side
# root-only file — never baked into the image or committed.
RUN useradd -m -u 1000 -s /bin/bash tester \
    && usermod -aG video,render tester \
    && useradd -m -u 1001 -s /bin/bash probe444 \
    && usermod -aG video,render probe444

COPY startwm.sh /etc/xrdp/startwm.sh
COPY banner.sh /usr/local/bin/banner.sh
COPY entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod 755 /etc/xrdp/startwm.sh /usr/local/bin/banner.sh \
              /usr/local/bin/entrypoint.sh

EXPOSE 3389
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
